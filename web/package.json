{
  "name": "league-of-agents-web",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write --ignore-path ../.prettierignore --ignore-path ../.gitignore \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,mjs}\" \"*.{ts,js}\" \"../bridge/*.mjs\" \"../tests/**/*.mjs\"",
    "format:check": "prettier --check --ignore-path ../.prettierignore --ignore-path ../.gitignore \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,mjs}\" \"*.{ts,js}\" \"../bridge/*.mjs\" \"../tests/**/*.mjs\"",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty && tsc -p ../bridge/tsconfig.json --pretty",
    "check:any": "! grep -rnwE \"any\" src/api src/state src/lib --include=*.ts --include=*.tsx",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test --project app --project live --project visual",
    "perf": "npm run build && playwright test --project perf",
    "large": "npm run build && playwright test --project large",
    "media": "npm run build && playwright test --project media",
    "states": "npm run build && playwright test --project states",
    "screens": "npm run build && playwright test --project screens",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:any && npm run test:unit",
    "test": "npm run check && npm run test:e2e",
    "smoke": "npm run build && playwright test --project app -g smoke"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "^1.0.3",
    "globals": "^17.12.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}
